{
  "name": "@hono-svelte/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "predev": "npm run build --prefix contracts",
    "worker": "tsx watch src/worker/worker.ts",
    "preworker": "npm run build --prefix contracts",
    "build": "tsc -p tsconfig.json",
    "prebuild": "npm run build --prefix contracts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/worker.js",
    "test": "vitest run",
    "pretest": "npm run build --prefix contracts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/seed-cli.ts"
  },
  "dependencies": {
    "@hono-svelte/contracts": "0.1.0",
    "@hono/node-server": "^1.19.6",
    "@hono/zod-openapi": "^1.1.5",
    "@scalar/hono-api-reference": "^0.9.30",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.1",
    "ioredis": "^5.8.1",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.18.8",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
